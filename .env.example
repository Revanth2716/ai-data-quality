# ── AI provider ────────────────────────────────────────────────────────────
# "mock"   -> deterministic offline provider (default; no key, no network)
# "openai" -> any OpenAI-compatible chat/completions endpoint
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=openai — never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECS=20

# ── Upload limits ──────────────────────────���────────────────────────────────
# Maximum accepted CSV upload size in MB (413 when exceeded)
MAX_UPLOAD_MB=10

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
